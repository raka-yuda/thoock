# PostgreSQL
DATABASE_URL=postgresql://stocklab:stocklab@localhost:5432/stocklab

# Single-user authentication. Generate a long random secret for production.
SESSION_SECRET=replace-with-at-least-32-random-characters
INITIAL_USER_EMAIL=owner@example.com
INITIAL_USER_PASSWORD=replace-during-user-create-command
# Optional database-free login fallback. Generate with: node -e "require('bcryptjs').hash('your-password', 12).then(console.log)"
APP_USER_EMAIL=
APP_PASSWORD_HASH=
# Development only. Never use in production.
AUTH_BYPASS=false
# Calendar-date filters use this fixed UTC offset. 420 = Asia/Jakarta (UTC+7).
APP_TIME_ZONE_OFFSET_MINUTES=420

# Provider mode
MOCK_MODE=true

# Paid model availability, capabilities, pricing, commercial terms, and verification dates are configured
# as JSON records. See README. Paid seed entries are disabled and unpriced by default.
GENERATION_MODEL_CATALOG_JSON=
# Use "database" after migrations and seed if PostgreSQL should be the runtime catalog source.
MODEL_CATALOG_SOURCE=defaults

# SnapGenAI: both values are required to enable the adapter.
SNAPGEN_API_BASE_URL=
SNAPGEN_API_KEY=

# Optional owner-controlled Cloudflare Workers AI proxy.
# The API key must match the Worker's API_KEY secret. Enter your own conservative
# per-image estimate so paid usage remains inside Stocklab's shared budget gate.
CLOUDFLARE_WORKER_AI_URL=
CLOUDFLARE_WORKER_AI_API_KEY=
CLOUDFLARE_WORKER_AI_ESTIMATED_COST_USD_PER_IMAGE=

# Optional Black Forest Labs adapter.
BFL_API_BASE_URL=https://api.bfl.ai/v1
BFL_API_KEY=

# Optional Gemini image and metadata adapters.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional paid AI upscale. Prices are deliberately blank until manually verified.
STABILITY_API_KEY=
STABILITY_FAST_UPSCALE_COST_USD=
STABILITY_CONSERVATIVE_UPSCALE_COST_USD=
STABILITY_CREATIVE_UPSCALE_COST_USD=
ENABLE_CREATIVE_UPSCALE=false

# Optional local Real-ESRGAN-compatible HTTP worker or executable. Configure one target only.
# Executable mode receives fixed -i, -o, and -s arguments; no user command fragments are executed.
LOCAL_UPSCALE_ENABLED=false
LOCAL_UPSCALE_URL=
LOCAL_UPSCALE_EXECUTABLE=

ADOBE_STOCK_API_URL=
ADOBE_STOCK_API_KEY=

# Storage
LOCAL_STORAGE_PATH=./storage

# Cost settings are seeded in PostgreSQL and editable in the application.
DEFAULT_MONTHLY_BUDGET_IDR=500000
DEFAULT_USD_TO_IDR=17650
